{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.2.0"
    },
    "kind": {
      "const": "observation"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "territory_id": {
      "type": "string",
      "minLength": 1
    },
    "sensed_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T.*Z$"
    },
    "available_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T.*Z$"
    },
    "ingested_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T.*Z$"
    },
    "bbox_wgs84": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 4,
      "maxItems": 4
    },
    "crs": {
      "type": "string",
      "minLength": 1
    },
    "native_resolution_m": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "coverage_fraction": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "quality": {
      "enum": [
        "VALID",
        "PARTIAL",
        "CONFLICT"
      ]
    },
    "asset": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "migration": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "from_version": {
              "const": "0.1.0"
            },
            "metadata_only": {
              "const": true
            }
          },
          "required": [
            "from_version",
            "metadata_only"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "kind",
    "id",
    "territory_id",
    "sensed_at",
    "available_at",
    "ingested_at",
    "bbox_wgs84",
    "crs",
    "native_resolution_m",
    "coverage_fraction",
    "quality",
    "asset",
    "license",
    "source",
    "migration"
  ],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:hazardia:0.2.0:observation"
}
