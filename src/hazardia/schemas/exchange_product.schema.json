{
  "type": "object",
  "properties": {
    "schema": {
      "const": "hazardia.exchange-product/0.1.0"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "domain_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "origin": {
      "enum": [
        "OBSERVED",
        "FORECAST",
        "SIMULATED"
      ]
    },
    "qualification": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "grid": {
      "type": "object",
      "properties": {
        "shape": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "minItems": 2,
          "maxItems": 2
        },
        "crs": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "axis_order": {
          "const": "X_Y"
        },
        "transform": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 6,
          "maxItems": 6
        },
        "nodata": {
          "type": "number"
        },
        "horizontal_unit": {
          "$ref": "#/definitions/knowledge"
        },
        "vertical_datum": {
          "$ref": "#/definitions/knowledge"
        }
      },
      "required": [
        "shape",
        "crs",
        "axis_order",
        "transform",
        "nodata",
        "horizontal_unit",
        "vertical_datum"
      ],
      "additionalProperties": false
    },
    "time": {
      "type": "object",
      "properties": {
        "valid_from": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "valid_until": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "source_cutoff": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "available_at": {
          "$ref": "#/definitions/knowledge"
        }
      },
      "required": [
        "valid_from",
        "valid_until",
        "source_cutoff",
        "available_at"
      ],
      "additionalProperties": false
    },
    "variables": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "quantity": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "unit": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "support": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "uncertainty": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "members": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1
              },
              "calibration": {
                "$ref": "#/definitions/knowledge"
              },
              "note": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              }
            },
            "required": [
              "kind",
              "members",
              "calibration",
              "note"
            ],
            "additionalProperties": false
          },
          "asset": {
            "$ref": "#/definitions/asset"
          },
          "statistics": {
            "type": "object",
            "properties": {
              "minimum": {
                "type": "number"
              },
              "maximum": {
                "type": "number"
              },
              "valid_cells": {
                "type": "integer",
                "minimum": 0
              },
              "positive_cells": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "minimum",
              "maximum",
              "valid_cells",
              "positive_cells"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "quantity",
          "unit",
          "support",
          "uncertainty",
          "asset",
          "statistics"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true
    },
    "provenance": {
      "type": "object",
      "properties": {
        "records": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "role": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "asset": {
                "$ref": "#/definitions/asset"
              }
            },
            "required": [
              "role",
              "asset"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true
        },
        "license": {
          "$ref": "#/definitions/knowledge"
        },
        "engine": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024
                },
                "source_revision": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024
                },
                "patch_sha256": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^[a-f0-9]{64}$"
                },
                "state": {
                  "const": "KNOWN"
                },
                "reason": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024
                }
              },
              "required": [
                "name",
                "source_revision",
                "patch_sha256",
                "state",
                "reason"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "state": {
                  "enum": [
                    "UNKNOWN",
                    "NOT_APPLICABLE"
                  ]
                },
                "reason": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024
                }
              },
              "required": [
                "state",
                "reason"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "records",
        "license",
        "engine"
      ],
      "additionalProperties": false
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      },
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true
    }
  },
  "required": [
    "schema",
    "id",
    "domain_id",
    "origin",
    "qualification",
    "grid",
    "time",
    "variables",
    "provenance",
    "assumptions"
  ],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:hazardia:exchange_product:0.1.0",
  "definitions": {
    "knowledge": {
      "type": "object",
      "properties": {
        "state": {
          "enum": [
            "KNOWN",
            "UNKNOWN",
            "NOT_APPLICABLE"
          ]
        },
        "value": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1024
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      },
      "required": [
        "state",
        "value",
        "reason"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "KNOWN"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              }
            }
          },
          "else": {
            "properties": {
              "value": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "asset": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false
    }
  }
}
