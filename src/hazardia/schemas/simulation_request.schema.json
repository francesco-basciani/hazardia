{
  "type": "object",
  "properties": {
    "schema_version": {
      "enum": [
        "0.2.0",
        "0.3.0"
      ]
    },
    "kind": {
      "const": "simulation_request"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "hazard": {
      "enum": [
        "FIRE",
        "FLOOD"
      ]
    },
    "mode": {
      "enum": [
        "RESEARCH_RETROSPECTIVE",
        "RESEARCH_FORECAST"
      ]
    },
    "territory": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "region": {
          "type": "string",
          "minLength": 1
        },
        "bbox_wgs84": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 4,
          "maxItems": 4
        },
        "work_crs": {
          "type": "string",
          "minLength": 1
        },
        "timezone": {
          "type": "string",
          "minLength": 1
        },
        "calibration": {
          "const": "UNKNOWN"
        },
        "complete_catchment": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "region",
        "bbox_wgs84",
        "work_crs",
        "timezone",
        "calibration",
        "complete_catchment"
      ],
      "additionalProperties": false
    },
    "grid": {
      "type": "object",
      "properties": {
        "shape": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "minItems": 2,
          "maxItems": 2
        },
        "crs": {
          "type": "string",
          "minLength": 1
        },
        "vertical_datum": {
          "type": "string",
          "minLength": 1
        },
        "transform": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 6,
          "maxItems": 6
        },
        "nodata": {
          "type": "number"
        }
      },
      "required": [
        "shape",
        "crs",
        "vertical_datum",
        "transform",
        "nodata"
      ],
      "additionalProperties": false
    },
    "snapshot_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T.*Z$"
    },
    "valid_from": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T.*Z$"
    },
    "valid_until": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T.*Z$"
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "enum": [
              "dem",
              "weather",
              "fire_arrays",
              "satellite",
              "weather_raw"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "role",
          "path",
          "sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "options": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "duration_s": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3600
            },
            "realizations": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10
            },
            "seed": {
              "type": "integer",
              "minimum": 0
            },
            "ignition": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0
              },
              "minItems": 2,
              "maxItems": 2
            },
            "moisture_percent": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "fuel_legacy": {
              "type": "integer",
              "minimum": 1,
              "maximum": 6
            }
          },
          "required": [
            "duration_s",
            "realizations",
            "seed",
            "ignition",
            "moisture_percent",
            "fuel_legacy"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "hours": {
              "type": "integer",
              "minimum": 2,
              "maximum": 12
            },
            "rain_mm": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": 0
              },
              "minItems": 2
            },
            "q0_m3_s": {
              "type": "number",
              "minimum": 0
            },
            "q0_evidence": {
              "const": "SYNTHETIC_RESEARCH_REFERENCE"
            },
            "flow_threshold_cells": {
              "type": "integer",
              "minimum": 1
            },
            "allow_experimental_patch": {
              "type": "boolean"
            }
          },
          "required": [
            "hours",
            "rain_mm",
            "q0_m3_s",
            "q0_evidence",
            "flow_threshold_cells",
            "allow_experimental_patch"
          ],
          "additionalProperties": false
        }
      ]
    },
    "timeout_s": {
      "type": "number",
      "minimum": 1,
      "maximum": 900
    },
    "max_log_bytes": {
      "type": "integer",
      "minimum": 1024,
      "maximum": 104857600
    }
  },
  "required": [
    "schema_version",
    "kind",
    "id",
    "hazard",
    "mode",
    "territory",
    "grid",
    "snapshot_at",
    "valid_from",
    "valid_until",
    "assets",
    "assumptions",
    "options",
    "timeout_s",
    "max_log_bytes"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "hazard": {
            "const": "FIRE"
          }
        }
      },
      "then": {
        "properties": {
          "options": {
            "type": "object",
            "properties": {
              "duration_s": {
                "type": "integer",
                "minimum": 1,
                "maximum": 3600
              },
              "realizations": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10
              },
              "seed": {
                "type": "integer",
                "minimum": 0
              },
              "ignition": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0
                },
                "minItems": 2,
                "maxItems": 2
              },
              "moisture_percent": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "fuel_legacy": {
                "type": "integer",
                "minimum": 1,
                "maximum": 6
              }
            },
            "required": [
              "duration_s",
              "realizations",
              "seed",
              "ignition",
              "moisture_percent",
              "fuel_legacy"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "hazard": {
            "const": "FLOOD"
          }
        }
      },
      "then": {
        "properties": {
          "options": {
            "type": "object",
            "properties": {
              "hours": {
                "type": "integer",
                "minimum": 2,
                "maximum": 12
              },
              "rain_mm": {
                "type": "array",
                "items": {
                  "type": "number",
                  "minimum": 0
                },
                "minItems": 2
              },
              "q0_m3_s": {
                "type": "number",
                "minimum": 0
              },
              "q0_evidence": {
                "const": "SYNTHETIC_RESEARCH_REFERENCE"
              },
              "flow_threshold_cells": {
                "type": "integer",
                "minimum": 1
              },
              "allow_experimental_patch": {
                "type": "boolean"
              }
            },
            "required": [
              "hours",
              "rain_mm",
              "q0_m3_s",
              "q0_evidence",
              "flow_threshold_cells",
              "allow_experimental_patch"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "mode": {
            "const": "RESEARCH_FORECAST"
          }
        }
      },
      "then": {
        "properties": {
          "schema_version": {
            "const": "0.3.0"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "0.2.0"
          }
        }
      },
      "then": {
        "properties": {
          "mode": {
            "const": "RESEARCH_RETROSPECTIVE"
          }
        }
      }
    }
  ],
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:hazardia:0.2.0:simulation_request"
}
