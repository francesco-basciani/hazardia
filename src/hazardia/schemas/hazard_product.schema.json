{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.2.0"
    },
    "kind": {
      "const": "hazard_product"
    },
    "job_id": {
      "type": "string",
      "minLength": 1
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "hazard": {
      "enum": [
        "FIRE",
        "FLOOD"
      ]
    },
    "qualification": {
      "const": "UNQUALIFIED_RESEARCH"
    },
    "grid": {
      "type": "object",
      "properties": {
        "shape": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "minItems": 2,
          "maxItems": 2
        },
        "crs": {
          "type": "string",
          "minLength": 1
        },
        "vertical_datum": {
          "type": "string",
          "minLength": 1
        },
        "transform": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 6,
          "maxItems": 6
        },
        "nodata": {
          "type": "number"
        }
      },
      "required": [
        "shape",
        "crs",
        "vertical_datum",
        "transform",
        "nodata"
      ],
      "additionalProperties": false
    },
    "valid_from": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T.*Z$"
    },
    "valid_until": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T.*Z$"
    },
    "engine": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "source_commit": {
          "type": "string",
          "minLength": 1
        },
        "patch_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "name",
        "source_commit",
        "patch_sha256"
      ],
      "additionalProperties": false
    },
    "layers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "enum": [
              "FIRE_PROBABILITY",
              "ARRIVAL_TIME",
              "MAXIMUM_DEPTH"
            ]
          },
          "unit": {
            "enum": [
              "1",
              "s",
              "m"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "statistics": {
            "type": "object",
            "properties": {
              "valid_cells": {
                "type": "integer",
                "minimum": 1
              },
              "positive_cells": {
                "type": "integer",
                "minimum": 0
              },
              "minimum": {
                "type": "number"
              },
              "maximum": {
                "type": "number"
              }
            },
            "required": [
              "valid_cells",
              "positive_cells",
              "minimum",
              "maximum"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "name",
          "unit",
          "path",
          "sha256",
          "statistics"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "input_hashes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "role",
          "sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "validation": {
      "type": "object",
      "properties": {
        "status": {
          "const": "PASS"
        },
        "scope": {
          "const": "TECHNICAL_CONTENT_ONLY"
        }
      },
      "required": [
        "status",
        "scope"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "kind",
    "job_id",
    "request_id",
    "hazard",
    "qualification",
    "grid",
    "valid_from",
    "valid_until",
    "engine",
    "layers",
    "assumptions",
    "input_hashes",
    "validation"
  ],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:hazardia:0.2.0:hazard_product"
}
