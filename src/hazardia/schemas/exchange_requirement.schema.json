{
  "type": "object",
  "properties": {
    "schema": {
      "const": "hazardia.exchange-requirement/0.1.0"
    },
    "domain_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "allowed_origins": {
      "type": "array",
      "items": {
        "enum": [
          "OBSERVED",
          "FORECAST",
          "SIMULATED"
        ]
      },
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true
    },
    "allowed_qualifications": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      },
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true
    },
    "grid": {
      "type": "object",
      "properties": {
        "shape": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "minItems": 2,
          "maxItems": 2
        },
        "crs": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "axis_order": {
          "const": "X_Y"
        },
        "transform": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 6,
          "maxItems": 6
        },
        "nodata": {
          "type": "number"
        },
        "horizontal_unit": {
          "$ref": "#/definitions/knowledge"
        },
        "vertical_datum": {
          "$ref": "#/definitions/knowledge"
        }
      },
      "required": [
        "shape",
        "crs",
        "axis_order",
        "transform",
        "nodata",
        "horizontal_unit",
        "vertical_datum"
      ],
      "additionalProperties": false
    },
    "time": {
      "type": "object",
      "properties": {
        "valid_from": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "valid_until": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "as_of": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      },
      "required": [
        "valid_from",
        "valid_until",
        "as_of"
      ],
      "additionalProperties": false
    },
    "variables": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "quantity": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "unit": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "support": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "accepted_uncertainty": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "minItems": 1,
            "maxItems": 64,
            "uniqueItems": true
          },
          "require_known_calibration": {
            "type": "boolean"
          },
          "minimum_members": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          }
        },
        "required": [
          "id",
          "quantity",
          "unit",
          "support",
          "accepted_uncertainty",
          "require_known_calibration",
          "minimum_members"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true
    },
    "require_known_license": {
      "type": "boolean"
    },
    "maximum_age_s": {
      "type": "number",
      "minimum": 0,
      "maximum": 315360000
    }
  },
  "required": [
    "schema",
    "domain_id",
    "allowed_origins",
    "allowed_qualifications",
    "grid",
    "time",
    "variables",
    "require_known_license",
    "maximum_age_s"
  ],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:hazardia:exchange_requirement:0.1.0",
  "definitions": {
    "knowledge": {
      "type": "object",
      "properties": {
        "state": {
          "enum": [
            "KNOWN",
            "UNKNOWN",
            "NOT_APPLICABLE"
          ]
        },
        "value": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1024
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      },
      "required": [
        "state",
        "value",
        "reason"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "KNOWN"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              }
            }
          },
          "else": {
            "properties": {
              "value": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  }
}
